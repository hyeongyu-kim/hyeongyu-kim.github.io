---
layout: default
---
<article class="editorial-note">
  <header class="editorial-page-heading">
    <a class="note-back" href="{{ '/notes/' | relative_url }}">← Research notes</a>
    <p class="editorial-eyebrow">{{ page.topic }}</p>
    <h1>{{ page.title }}</h1>
    <p>{{ page.description }}</p>
    <p class="editorial-updated">{{ page.updated | date: '%B %-d, %Y' }} · {{ page.reading_time }} min read</p>
  </header>
  <div class="note-prose">{{ content }}</div>
  <footer class="note-footer">
    <a href="{{ '/notes/' | relative_url }}">All notes</a><a href="{{ '/lab/' | relative_url }}">Try the interactive lab ↗</a>
  </footer>
</article>
